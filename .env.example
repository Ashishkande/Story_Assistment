# ============================================================
# LLM Configuration
# ============================================================
# Provider: openai | anthropic | google
LLM_PROVIDER=openai

# Model name (must match provider)
LLM_MODEL=gpt-4o-mini

# API Keys (only set the one matching your provider)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# LLM Temperature (0.0 - 1.0)
LLM_TEMPERATURE=0.7

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql+asyncpg://story_user:story_pass@localhost:5432/story_db
DATABASE_URL_SYNC=postgresql+psycopg2://story_user:story_pass@localhost:5432/story_db

# ============================================================
# Application
# ============================================================
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret
LOG_LEVEL=INFO
PORT=8000
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Used by the frontend container build (browser-facing API URL)
VITE_API_URL=http://localhost:8000

# ============================================================
# Cost & Retry Controls
# ============================================================
MAX_REVISIONS=2
MAX_RETRIES=3
MAX_TOKENS_PER_EPISODE=4000
MAX_COST_PER_EPISODE=0.50
MAX_COST_PER_RUN=5.00

# ============================================================
# Episode Generation
# ============================================================
EPISODE_MIN_WORDS=400
EPISODE_MAX_WORDS=700
TOTAL_EPISODES=200

# ============================================================
# Embeddings (optional – for repetition detection)
# ============================================================
ENABLE_EMBEDDINGS=false
